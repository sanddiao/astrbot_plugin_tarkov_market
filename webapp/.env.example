# 塔科夫信息检索系统 · 环境配置

# 服务端口
PORT=3000

# SQLite 数据库文件路径（相对项目根）
DB_PATH=./data/tarkov.db

# tarkov.dev 数据源
TARKOV_ITEMS_URL=https://json.tarkov.dev/regular/items
TARKOV_ITEMS_ZH_URL=https://json.tarkov.dev/regular/items_zh

# 自动同步间隔（秒），默认 600（10 分钟）
SYNC_INTERVAL_SECONDS=600

# 是否禁用自动定时同步（设 1 禁用，仅保留首次空表同步 + 手动触发）
DISABLE_AUTO_SYNC=0
